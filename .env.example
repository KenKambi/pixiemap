# OpenRouter key used by both Netlify Functions (never exposed to the browser)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional
SITE_URL=https://pixiemap-makueni.netlify.app
PIXIEBOT_MODEL=meta-llama/llama-3.1-8b-instruct
# Vision model(s) for the AI crop check. Leave unset to use the built-in
# fallback list, or give a comma-separated list - they are tried in order.
DIAGNOSE_MODEL=google/gemini-2.5-flash,google/gemini-2.0-flash-001,openai/gpt-4o-mini
